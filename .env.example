# ==========================================================
# STOCK SEÑALES — Variables de entorno de ejemplo
# Copie este archivo como .env.local y complete los valores.
# NUNCA suba .env.local al repositorio.
# ==========================================================

# --- Públicas (se envían al navegador; son seguras por diseño) ---
# URL del proyecto Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública: "publishable key" (sb_publishable_...) o la clave "anon" heredada.
# Toda la seguridad de datos la aplica RLS en PostgreSQL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública de la aplicación (se usa en los códigos QR y en los enlaces de invitación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secretas (SÓLO servidor; jamás con prefijo NEXT_PUBLIC_) ---
# "secret key" (sb_secret_...) o la clave "service_role" heredada.
# Se usa únicamente en acciones de servidor de administración de usuarios.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Sólo para pruebas e2e / script de usuarios de prueba ---
E2E_BASE_URL=http://localhost:3000
E2E_TRABAJADOR_CORREO=trabajador.prueba@stock-senales.test
E2E_TRABAJADOR_CLAVE=Prueba#2026
E2E_ADMIN_CORREO=admin.prueba@stock-senales.test
E2E_ADMIN_CLAVE=Prueba#2026
